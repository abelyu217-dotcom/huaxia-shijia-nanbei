; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="家业-南北篇"
config/description="以魏晋南北朝为时代背景的家族养成策略游戏"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

GameManager="*res://scripts/managers/GameManager.gd"
FamilyManager="*res://scripts/managers/FamilyManager.gd"
CharacterManager="*res://scripts/managers/CharacterManager.gd"
RelationshipManager="*res://scripts/managers/RelationshipManager.gd"
TimeManager="*res://scripts/managers/TimeManager.gd"
EventManager="*res://scripts/managers/EventManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
EstateManager="*res://scripts/managers/EstateManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

advance_dialog={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_render/layer_name_0="Background"
2d_render/layer_name_1="UI"
2d_render/layer_name_2="Dialog"
2d_render/layer_name_3="Popup"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_extensions/keep_texture_settings=true