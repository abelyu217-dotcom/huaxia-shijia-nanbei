# HWO 本地开发环境变量（docker-compose 配套）
# 复制为 .env 后按需修改

# PostgreSQL
DATABASE_URL=postgresql://hwo:hwo_dev@localhost:5432/hwo

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3 兼容对象存储)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=hwo
S3_SECRET_KEY=hwo_dev
S3_BUCKET=hwo-replays

# API
API_PORT=3000
JWT_SECRET=dev-secret-change-in-production

# sim 灰度参数（Redis key: sim-config:live）
SIM_CONFIG_POSSESSIONS_PER_QUARTER=25
SIM_CONFIG_HOME_ADVANTAGE=3
