    {
      "datasource": { "type": "postgres", "uid": "hwo_pg" },
      "description": "D1/D7/D30 留存率：cohort 当日活跃用户在 1/7/30 天后仍活跃的比例",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "hwo_pg" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH cohort AS (SELECT date, COUNT(DISTINCT user_id) AS size FROM daily_active_snapshot WHERE date >= time_zone('utc', now()) - interval '30 days' GROUP BY date), retained AS (SELECT c.date AS cohort_date, n.n_day, COUNT(DISTINCT s.user_id)::float / c.size AS rate FROM cohort c JOIN LATERAL (VALUES (1, 'd1'), (7, 'd7'), (30, 'd30')) AS n(n_day, label) ON true LEFT JOIN daily_active_snapshot s ON s.user_id IN (SELECT user_id FROM daily_active_snapshot WHERE date = c.date) AND s.date = c.date + (n.n_day || ' days')::interval GROUP BY c.date, n.n_day, c.size) SELECT cohort_date AS time, 'd1' AS metric, rate FROM retained WHERE n_day = 1 UNION ALL SELECT cohort_date, 'd7', rate FROM retained WHERE n_day = 7 UNION ALL SELECT cohort_date, 'd30', rate FROM retained WHERE n_day = 30",
          "refId": "A"
        }
      ],
      "title": "留存漏斗（D1/D7/D30）",
      "type": "timeseries"
    },
