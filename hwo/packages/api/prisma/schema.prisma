// HWO Prisma Schema
// 参见：开发计划.html §2.1 数据持久化层
// 复杂嵌套结构（abilities/lineup/tactic/pbp/box_score）使用 Json 存储，
// 与 @hwo/shared 的 TypeScript 类型一一对应，保证前后端类型共享。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── 用户 ───
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teams Team[]
}

// ─── 世界 ───
// M2：多玩家世界容器，一个世界包含 16 支球队（真实玩家 + AI 填充），
// 分 L1/L2 两级联赛。世界内经济封闭，跨世界不可交易。
model World {
  id          String       @id @default(cuid())
  name        String
  seasonId    String
  season      Season       @relation(fields: [seasonId], references: [id])
  teams       Team[]
  leagues     League[]
  tradeOffers TradeOffer[]

  createdAt DateTime @default(now())
}

// ─── 联赛 ───
model League {
  id        String     @id @default(cuid())
  name      String
  level     Int        @default(1) // 1 = L1 顶级联赛 | 2 = L2 次级联赛
  worldId   String?
  world     World?     @relation(fields: [worldId], references: [id])
  seasonId  String
  season    Season     @relation(fields: [seasonId], references: [id])
  teams     Team[]
  matches   Match[]
  standings Standing[]

  createdAt DateTime @default(now())
}

// ─── 赛季 ───
model Season {
  id         String   @id @default(cuid())
  year       Int
  name       String // 如 "2026-2027"
  status     String   @default("regular") // regular | playoff | offseason
  currentDay Int      @default(1)
  leagues    League[]
  matches    Match[]
  worlds     World[]
  draftPicks DraftPick[]
  createdAt  DateTime @default(now())
}

// ─── 球队 ───
model Team {
  id        String  @id
  name      String
  city      String?
  chemistry Int     @default(60)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  worldId  String?
  world    World?  @relation(fields: [worldId], references: [id])
  leagueId String?
  league   League? @relation(fields: [leagueId], references: [id])

  players     Player[]
  lineup      Lineup?
  tactic      Tactic?
  // 队长（#20）：手动指定，每队 1 人
  captainId   String?
  homeMatches Match[]    @relation("HomeTeam")
  awayMatches Match[]    @relation("AwayTeam")
  standings   Standing[]

  // 作为交易参与方
  tradeOffersAsOfferor TradeOffer[] @relation("OfferorTeam")
  tradeOffersAsOfferee TradeOffer[] @relation("OffereeTeam")

  // M3
  academy     Academy?
  draftPicks  DraftPick[]  @relation("DraftPicks")
  contracts   Contract[]   @relation("Contracts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── 球员 ───
model Player {
  id        String @id
  teamId    String
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  position  String // PG | SG | SF | PF | C
  abilities Json // Abilities 接口（17 项能力值）
  traits    Json // string[] 特质 ID 列表
  age       Int    @default(25)
  salary    Int    @default(0)

  // M3: 生涯弧线
  potential Int?     @default(75) // 潜力上限（0-99）
  trainExp  Int      @default(0)  // 训练经验值（累积）
  retired   Boolean  @default(false) // 是否已退役
  retireSeason Int?  // 退役赛季年份

  // 状态体系（#13）：疲劳累积 + 状态等级
  fatigue   Int      @default(0)  // 疲劳值 0-100，随出场时间累积，休息日恢复
  status    String   @default("good") // peak | good | tired | exhausted

  // M3: 关系
  contract  Contract?
  draftPick DraftPick?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([retired])
}

// ─── 阵容（首发 + 上场时间） ───
model Lineup {
  id        String   @id @default(cuid())
  teamId    String   @unique
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  starters  Json // string[] 5 个 player id
  minutes   Json // Record<string, number> 目标出场时间
  updatedAt DateTime @updatedAt
}

// ─── 战术 ───
model Tactic {
  id        String   @id @default(cuid())
  teamId    String   @unique
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  presetId  String // 战术预设 ID（对应 tactics.ts 的预设库）
  modSet    Json // TacticModSet 完整参数
  updatedAt DateTime @updatedAt
}

// ─── 战术使用率统计（M4 #8） ───
model TacticUsage {
  id            String  @id @default(cuid())
  presetId      String  @unique // 战术预设 ID
  gamesPlayed   Int     @default(0) // 使用该战术的比赛场数
  wins          Int     @default(0) // 胜场
  losses        Int     @default(0) // 负场
  pointsFor     Int     @default(0) // 总得分
  pointsAgainst Int     @default(0) // 总失分
  updatedAt     DateTime @updatedAt
}

// ─── 比赛 ───
model Match {
  id       String  @id @default(cuid())
  seasonId String
  season   Season  @relation(fields: [seasonId], references: [id])
  leagueId String?
  league   League? @relation(fields: [leagueId], references: [id])

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  day         Int // 赛季第几日
  scheduledAt DateTime?
  status      String    @default("scheduled") // scheduled | settled
  seed        Int? // sim 随机种子

  result MatchResult?

  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@index([seasonId, day])
  @@index([status])
}

// ─── 比赛结果（PBP + Box Score） ───
model MatchResult {
  id      String @id @default(cuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  homeScore Int
  awayScore Int
  winnerId  String
  loserId   String
  isClutch  Boolean @default(false)

  pbp           Json // PbpEvent[] 逐回合事件
  boxScore      Json // BoxScore 技术统计
  quarterScores Json // { home: number[], away: number[] }
  rngLog        Json? // RngLogEntry[] 审计日志（可选，防作弊）
  seed          Int

  createdAt DateTime @default(now())
}

// ─── 积分榜 ───
model Standing {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])
  seasonId String

  wins          Int     @default(0)
  losses        Int     @default(0)
  pointsFor     Int     @default(0) // 总得分
  pointsAgainst Int     @default(0) // 总失分
  streak        String? // 如 "W3" 或 "L2"

  updatedAt DateTime @updatedAt

  @@unique([leagueId, teamId])
}

// ─── 交易报价 ───
// M2：跨经理交易系统。状态机：pending → accepted | rejected | countered | expired
// 报价筹码：球员 + 选秀权 + 现金；薪资匹配规则：双方薪资差 ≤ 25%
model TradeOffer {
  id      String   @id @default(cuid())
  worldId String?
  world   World?   @relation(fields: [worldId], references: [id])

  offerorTeamId String
  offerorTeam   Team   @relation("OfferorTeam", fields: [offerorTeamId], references: [id])
  offereeTeamId String
  offereeTeam   Team   @relation("OffereeTeam", fields: [offereeTeamId], references: [id])

  // 筹码：球员 ID 列表 + 现金
  offerorPlayers Json // string[] 报价方送出的球员
  offereePlayers Json // string[] 报价方索要的球员
  offerorCash    Int  @default(0) // 报价方送出的现金
  offereeCash    Int  @default(0) // 报价方索要的现金

  status    String   @default("pending") // pending | accepted | rejected | countered | expired
  round     Int      @default(1) // 第几轮（最多 3 轮还价）
  expiresAt DateTime // 报价过期时间（创建后 24h）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId, status])
  @@index([offerorTeamId, status])
  @@index([offereeTeamId, status])
}

// ─── M3: 青训学院 ───
model Academy {
  id          String  @id @default(cuid())
  teamId      String  @unique
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  level       Int     @default(1)    // 学院等级 1-5
  investment  Int     @default(0)    // 累计投入资金
  lastProdYear Int?   // 上次产出年份

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── M3: 选秀 ───
model DraftPick {
  id        String  @id @default(cuid())
  seasonId  String
  season    Season  @relation(fields: [seasonId], references: [id])
  worldId   String?
  round     Int     // 第几轮（1 或 2）
  pickNum   Int     // 该轮顺位（1-16）
  teamId    String? // 拥有此顺位的球队
  team      Team?   @relation("DraftPicks", fields: [teamId], references: [id])
  playerId  String? @unique // 选中的球员
  player    Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([seasonId, round, pickNum])
  @@index([seasonId])
  @@index([teamId])
}

// ─── M3: 球员合同 ───
model Contract {
  id          String   @id @default(cuid())
  playerId    String   @unique
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team     @relation("Contracts", fields: [teamId], references: [id])
  yearsTotal  Int      // 合同总年数
  yearsRemain Int      // 剩余年数
  salaryPerYear Int    // 年薪
  playerOption Boolean @default(false) // 球员选项（最后一年可提前跳出）
  teamOption   Boolean @default(false) // 球队选项
  noTrade     Boolean  @default(false) // 交易否决权
  status      String   @default("active") // active | expired | waived

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teamId, status])
}
