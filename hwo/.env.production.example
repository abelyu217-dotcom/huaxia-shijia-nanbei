# HWO 生产环境变量（腾讯云部署）
# 复制为 .env 后填写真实值，禁止提交到 git
# 生成强密码：openssl rand -base64 32

# PostgreSQL
POSTGRES_USER=hwo
POSTGRES_PASSWORD=__REPLACE_ME_WITH_STRONG_PASSWORD__
POSTGRES_DB=hwo

# Redis
REDIS_PASSWORD=__REPLACE_ME_WITH_STRONG_PASSWORD__

# MinIO
MINIO_ROOT_USER=hwo
MINIO_ROOT_PASSWORD=__REPLACE_ME_WITH_STRONG_PASSWORD__
S3_BUCKET=hwo-replays

# API
JWT_SECRET=__REPLACE_ME_WITH_STRONG_PASSWORD__

# sim 灰度参数
SIM_CONFIG_POSSESSIONS_PER_QUARTER=25
SIM_CONFIG_HOME_ADVANTAGE=3

# Web 对外端口（腾讯云安全组需放行）
WEB_PORT=80
