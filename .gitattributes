# Git 属性

# 自动检测文本文件并规范化
* text=auto

# Godot 文件
*.tscn       text eol=lf
*.gd         text eol=lf
*.cs         text eol=lf
*.tres       text eol=lf

# 文档
*.md         text eol=lf
*.txt        text eol=lf

# Windows 脚本
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Unix 脚本
*.sh         text eol=lf

# 配置
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.toml       text eol=lf

# 二进制
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.gz         binary
*.tar        binary
*.exe        binary
*.dll        binary
*.so         binary
*.dylib      binary

# Godot 导入
*.import     merge=unityyamlmerge eol=lf

# LFS 跟踪
*.psd        filter=lfs diff=lfs merge=lfs -text
*.ai         filter=lfs diff=lfs merge=lfs -text
*.sketch     filter=lfs diff=lfs merge=lfs -text
*.blend      filter=lfs diff=lfs merge=lfs -text
*.wav        filter=lfs diff=lfs merge=lfs -text
*.mp3        filter=lfs diff=lfs merge=lfs -text
*.ogg        filter=lfs diff=lfs merge=lfs -text
*.flac       filter=lfs diff=lfs merge=lfs -text

# 导出配置
[attr]lfs    filter=lfs diff=lfs merge=lfs -text